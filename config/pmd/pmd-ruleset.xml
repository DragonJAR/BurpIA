<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="BurpIA PMD Rules"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/pmd-7.0.0/ruleset_xml_schema.xsd">

    <description>
        Reglas base activas para mantener guardrails reales en BurpIA sin introducir
        una migración masiva de estilo en esta primera ronda de saneamiento.
    </description>

    <rule ref="category/java/codestyle.xml/ClassNamingConventions"/>
    <rule ref="category/java/codestyle.xml/FieldNamingConventions">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::ClassOrInterfaceDeclaration[@SimpleName='I18nUI' or @SimpleName='I18nLogs' or @SimpleName='EstilosUI' or @SimpleName='EvidenceManager' or @SimpleName='TaskExecutionManager' or @SimpleName='ModeloTablaHallazgos' or @SimpleName='AlmacenEvidenciaHttp' or @SimpleName='GestorConsolaGUI' or @SimpleName='GestorMultiProveedor' or @SimpleName='AnalizadorAI' or @SimpleName='PanelAgente' or @SimpleName='ParserRespuestasAI' or @SimpleName='TestDialogUtils' or @SimpleName='EnterProbeProcess']"/>
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::ClassOrInterfaceDeclaration[@SimpleName='ParserRespuestasAI' or @SimpleName='ControlCancelacionPausaTest' or @SimpleName='LimitadorTasaTest' or @SimpleName='EnterProbeProcessTest' or @SimpleName='ManejadorHttpBurpIATest']"/>
        </properties>
    </rule>
    <rule ref="category/java/codestyle.xml/EmptyControlStatement">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::ClassOrInterfaceDeclaration[@SimpleName='OrquestadorAnalisis']"/>
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/AssignmentInOperand">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::ClassOrInterfaceDeclaration[@SimpleName='ManejadorHttpBurpIATest' or @SimpleName='EnterProbeProcess']"/>
        </properties>
    </rule>

    <!-- Detección automática de imports no usados.
         Sin esta regla pasan invisibles al build y se acumulan con el tiempo. -->
    <rule ref="category/java/codestyle.xml/UnnecessaryImport"/>

    <!-- Detección automática de código muerto (AGENTS.md §4).
         Estas reglas son la red de seguridad que evita que métodos, variables
         locales y asignaciones huérfanas se acumulen en el código. PMD las
         marca en build (ignoreFailures=false) para que no pasen invisibles.

         NOTA: UnusedPrivateField se excluye intencionalmente. En este proyecto
         los contenedores Swing (DialogoConfiguracion) usan inyección y
         delegación, lo que produce falsos positivos masivos. La detección de
         campos huérfanos se hace con escaneo manual guiado por auditoría.
         Las 3 reglas incluidas tienen alta precisión (pocos falsos positivos)
         y respetan @Override y @SuppressWarnings cuando aplica. -->
    <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod"/>
    <rule ref="category/java/bestpractices.xml/UnusedLocalVariable"/>
    <rule ref="category/java/bestpractices.xml/UnusedAssignment"/>
</ruleset>